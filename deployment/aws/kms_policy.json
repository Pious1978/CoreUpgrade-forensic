{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "EnforceInstitutionalTradingEngineKMSContext",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::ACCOUNT_ID:role/TradingEngineWorkloadRole"
      },
      "Action": "kms:Sign",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "kms:EncryptionContext:service": "institutional-trading-engine",
          "kms:EncryptionContext:environment": "PRODUCTION"
        },
        "StringLike": {
          "kms:EncryptionContext:purpose": "*"
        }
      }
    }
  ]
}