{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowExecutionSidecarToSignExecutionGate",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::ACCOUNT_ID:role/TradingEngineExecutionSidecarRole"
      },
      "Action": [
        "kms:Sign",
        "kms:GetPublicKey"
      ],
      "Resource": "*"
    }
  ]
}